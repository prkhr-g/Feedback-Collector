NODE_ENV=development
PORT=3000
# Set to the exact number of trusted reverse proxies in production (for example, 1 behind a single host proxy).
TRUST_PROXY_HOPS=0
# Neon CLI writes DATABASE_URL and DATABASE_URL_UNPOOLED to root .env.local.
# Optional local MySQL source settings used only by the one-time migration tool.
DB_HOST=localhost
DB_PORT=3306
DB_USER=feedback_app
DB_PASSWORD=replace_with_your_local_mysql_password
DB_NAME=feedback_collector
DB_SSL=false
DB_SSL_CA_PATH=
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cloudflare documented test secret for local development only.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CLIENT_ORIGIN=http://localhost:5173
