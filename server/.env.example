NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=feedback_app
DB_PASSWORD=replace_with_your_local_mysql_password
DB_NAME=feedback_collector
# Local MySQL uses no TLS. Set true only for a MySQL server configured for TLS.
DB_SSL=false
# Optional CA certificate path when DB_SSL=true and the server needs one.
DB_SSL_CA_PATH=
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cloudflare documented test secret for local development only.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CLIENT_ORIGIN=http://localhost:5173
